
Процедура ВывестиСправку()
	Сообщить("Использование: oscript generate-md.os <ПутьККаталогуСРасширением> <ПутьККаталогуВыходаРезкльтата>");
КонецПроцедуры

// Формирует markdown-документацию по экспортным методам модулей расширения.
//
// Параметры:
//  КаталогРасширения - Строка - путь к каталогу с выгрузкой расширения в файлы XML.
//  КаталогВывода - Строка - путь к каталогу, в который будет записана документация.
//
// Возвращаемое значение:
//  Структура - результат генерации:
//   * КодВозврата - Булево - Истина, если документация сформирована;
//   * КоличествоОбъектов - Число - количество описанных объектов расширения;
//   * КоличествоМетодов - Число - количество описанных экспортных методов;
//   * Лог - Строка - журнал выполнения.
//
Функция СгенерироватьДокументацию(КаталогРасширения, КаталогВывода)

	Результат = Новый Структура;
	Результат.Вставить("КодВозврата", Ложь);
	Результат.Вставить("КоличествоОбъектов", 0);
	Результат.Вставить("КоличествоМетодов", 0);
	Результат.Вставить("Лог", "");

	Журнал = Новый Массив;

	КаталогРасширения = НормализоватьПуть(КаталогРасширения);
	КаталогВывода = НормализоватьПуть(КаталогВывода);

	ФайлКаталога = Новый Файл(КаталогРасширения);
	Если Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
		Результат.Лог = "Каталог выгрузки расширения не найден: " + КаталогРасширения;
		Возврат Результат;
	КонецЕсли;

	ФайлыМодулей = НайтиФайлы(КаталогРасширения, "*.bsl", Истина);
	Если ФайлыМодулей.Количество() = 0 Тогда
		Результат.Лог = "В каталоге не найдено ни одного модуля (*.bsl): " + КаталогРасширения;
		Возврат Результат;
	КонецЕсли;

	СоответствиеТипов = СоответствиеНаименованийТипов();
	Объекты = Новый Соответствие;

	Для Каждого ФайлМодуля Из ФайлыМодулей Цикл
		Попытка
			ОбработатьМодуль(ФайлМодуля.ПолноеИмя, КаталогРасширения, СоответствиеТипов, Объекты, Журнал);
		Исключение
			ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Журнал.Добавить("Ошибка обработки " + ФайлМодуля.ПолноеИмя + ": " + ОписаниеОшибки);
		КонецПопытки;
	КонецЦикла;

	КоличествоМетодов = ЗаписатьДокументацию(КаталогВывода, Объекты, СоответствиеТипов, Журнал);

	Результат.КодВозврата = Истина;
	Результат.КоличествоОбъектов = Объекты.Количество();
	Результат.КоличествоМетодов = КоличествоМетодов;
	Результат.Лог = СтрСоединить(Журнал, Символы.ПС);

	Возврат Результат;

КонецФункции

Процедура ОбработатьМодуль(ПолноеИмя, КаталогРасширения, СоответствиеТипов, Объекты, Журнал)

	Относительный = ОтносительныйПуть(ПолноеИмя, КаталогРасширения);
	Сегменты = СтрРазделить(Относительный, "/", Ложь);
	Если Сегменты.Количество() < МинимальноеЧислоСегментовПути() Тогда
		Возврат;
	КонецЕсли;

	ИндексТипа = ИндексКаталогаТипа(Сегменты, СоответствиеТипов);
	Если (ИндексТипа + 1) >= Сегменты.Количество() Тогда
		Возврат;
	КонецЕсли;

	ТипКаталог = Сегменты[ИндексТипа];
	ИмяОбъекта = Сегменты[ИндексТипа + 1];

	Остаток = Новый Массив;
	Для Индекс = ИндексТипа + 2 По Сегменты.Количество() - 1 Цикл
		Остаток.Добавить(Сегменты[Индекс]);
	КонецЦикла;
	ВидМодуля = ОписаниеМодуля(Остаток);

	Методы = РазобратьЭкспортныеМетоды(ПрочитатьТекстФайла(ПолноеИмя));
	Если Методы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КлючОбъекта = ТипКаталог + "/" + ИмяОбъекта;
	ОписаниеОбъекта = Объекты.Получить(КлючОбъекта);
	Если ОписаниеОбъекта = Неопределено Тогда
		ОписаниеОбъекта = Новый Структура;
		ОписаниеОбъекта.Вставить("ТипКаталог", ТипКаталог);
		ОписаниеОбъекта.Вставить("Имя", ИмяОбъекта);
		ОписаниеОбъекта.Вставить("Синоним", ПрочитатьСиноним(КаталогРасширения, Сегменты, ИндексТипа + 1, ИмяОбъекта));
		ОписаниеОбъекта.Вставить("Модули", Новый Массив);
		Объекты.Вставить(КлючОбъекта, ОписаниеОбъекта);
	КонецЕсли;

	Модуль = Новый Структура;
	Модуль.Вставить("Вид", ВидМодуля);
	Модуль.Вставить("Методы", Методы);
	ОписаниеОбъекта.Модули.Добавить(Модуль);

	СтрокаЖурнала = ТипКаталог + "." + ИмяОбъекта + " / " + ВидМодуля
		+ ": методов " + Формат(Методы.Количество(), "ЧГ=0");
	Журнал.Добавить(СтрокаЖурнала);

КонецПроцедуры

Функция РазобратьЭкспортныеМетоды(ТекстМодуля)

	Методы = Новый Массив;
	Строки = СтрРазделить(ТекстМодуля, Символы.ПС, Ложь);
	БуферКомментария = Новый Массив;

	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл

		СтрокаТекста = СокрЛП(Строки[Индекс]);

		Если СтрНачинаетсяС(СтрокаТекста, "//") Тогда
			БуферКомментария.Добавить(Сред(СтрокаТекста, 3));
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СтрокаТекста) Тогда
			БуферКомментария.Очистить();
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(СтрокаТекста, "&") Или СтрНачинаетсяС(СтрокаТекста, "#") Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		КлючевоеСлово = КлючевоеСловоОбъявления(СтрокаТекста);
		Если ПустаяСтрока(КлючевоеСлово) Тогда
			БуферКомментария.Очистить();
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Объявление = СобратьОбъявление(Строки, Индекс);
		СтрокОбъявления = Объявление.Строк;
		Объявление = Объявление.Текст;

		Индекс = Индекс + СтрокОбъявления;

		Если ЭтоЭкспортноеОбъявление(Объявление) Тогда
			Метод = РазобратьОбъявление(Объявление, КлючевоеСлово);
			Метод.Комментарий = СтрСоединить(БуферКомментария, Символы.ПС);
			РазобратьКомментарий(Метод);
			Методы.Добавить(Метод);
		КонецЕсли;

		БуферКомментария.Очистить();

	КонецЦикла;

	Возврат Методы;

КонецФункции

Функция СобратьОбъявление(Строки, НачальныйИндекс)

	Объявление = СокрЛП(Строки[НачальныйИндекс]);
	СтрокОбъявления = 1;

	Пока СтрНайти(Объявление, ")") = 0
		И СтрокОбъявления < МаксимумСтрокОбъявления()
		И (НачальныйИндекс + СтрокОбъявления) < Строки.Количество() Цикл
		Объявление = Объявление + " " + СокрЛП(Строки[НачальныйИндекс + СтрокОбъявления]);
		СтрокОбъявления = СтрокОбъявления + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Текст", Объявление);
	Результат.Вставить("Строк", СтрокОбъявления);

	Возврат Результат;

КонецФункции

Функция КлючевоеСловоОбъявления(СтрокаТекста)

	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("Процедура");
	КлючевыеСлова.Добавить("Функция");
	КлючевыеСлова.Добавить("Procedure");
	КлючевыеСлова.Добавить("Function");

	Для Каждого КлючевоеСлово Из КлючевыеСлова Цикл
		Если СтрНачинаетсяС(СтрокаТекста, КлючевоеСлово + " ")
			Или СтрНачинаетсяС(СтрокаТекста, КлючевоеСлово + Символы.Таб) Тогда
			Возврат КлючевоеСлово;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЭтоЭкспортноеОбъявление(Объявление)

	ПозицияЗакрывающей = СтрНайти(Объявление, ")");
	Если ПозицияЗакрывающей = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = НРег(СокрЛП(Сред(Объявление, ПозицияЗакрывающей + 1)));

	Возврат СтрНачинаетсяС(Хвост, "экспорт") Или СтрНачинаетсяС(Хвост, "export");

КонецФункции

Функция РазобратьОбъявление(Объявление, КлючевоеСлово)

	Метод = Новый Структура;
	Метод.Вставить("ЭтоФункция", КлючевоеСлово = "Функция" Или КлючевоеСлово = "Function");
	Метод.Вставить("Имя", "");
	Метод.Вставить("Заголовок", "");
	Метод.Вставить("Сигнатура", "");
	Метод.Вставить("Параметры", Новый Массив);
	Метод.Вставить("Комментарий", "");
	Метод.Вставить("Описание", "");
	Метод.Вставить("ДокументацияПараметров", Новый Соответствие);
	Метод.Вставить("ВозвращаемоеЗначение", "");
	Метод.Вставить("Пример", "");

	ПозицияОткрывающей = СтрНайти(Объявление, "(");
	ПозицияЗакрывающей = СтрНайти(Объявление, ")");
	Если ПозицияОткрывающей = 0 Или ПозицияЗакрывающей = 0 Тогда
		Возврат Метод;
	КонецЕсли;

	ДлинаКлючевогоСлова = СтрДлина(КлючевоеСлово);
	ДлинаИмени = ПозицияОткрывающей - ДлинаКлючевогоСлова - 1;
	Метод.Имя = СокрЛП(Сред(Объявление, ДлинаКлючевогоСлова + 1, ДлинаИмени));

	ДлинаПараметров = ПозицияЗакрывающей - ПозицияОткрывающей - 1;
	ПараметрыСтрока = Сред(Объявление, ПозицияОткрывающей + 1, ДлинаПараметров);
	Для Каждого Параметр Из СтрРазделить(ПараметрыСтрока, ",", Ложь) Цикл
		ИмяПараметра = СокрЛП(Параметр);
		Если Не ПустаяСтрока(ИмяПараметра) Тогда
			Метод.Параметры.Добавить(ИмяПараметра);
		КонецЕсли;
	КонецЦикла;

	Метод.Заголовок = ?(Метод.ЭтоФункция, "Функция ", "Процедура ") + Метод.Имя;
	Метод.Сигнатура = Метод.Заголовок + "(" + СтрСоединить(Метод.Параметры, ", ") + ") Экспорт";

	Возврат Метод;

КонецФункции

Процедура РазобратьКомментарий(Метод)

	Если ПустаяСтрока(СокрЛП(Метод.Комментарий)) Тогда
		Возврат;
	КонецЕсли;

	СтрокиКомментария = СтрРазделить(Метод.Комментарий, Символы.ПС, Ложь);
	Секция = "Описание";
	СтрокиОписания = Новый Массив;
	СтрокиПараметров = Новый Массив;
	СтрокиВозврата = Новый Массив;
	СтрокиПримера = Новый Массив;

	Для Каждого ТекСтрока Из СтрокиКомментария Цикл

		НоваяСекция = СекцияКомментария(ТекСтрока);
		Если Не ПустаяСтрока(НоваяСекция) Тогда
			Секция = НоваяСекция;
			Продолжить;
		КонецЕсли;

		Если Секция = "Описание" Тогда
			СтрокиОписания.Добавить(ТекСтрока);
		ИначеЕсли Секция = "Параметры" Тогда
			СтрокиПараметров.Добавить(ТекСтрока);
		ИначеЕсли Секция = "Возвращаемое значение" Тогда
			СтрокиВозврата.Добавить(ТекСтрока);
		ИначеЕсли Секция = "Пример" Тогда
			СтрокиПримера.Добавить(ТекСтрока);
		Иначе
			Продолжить;
		КонецЕсли;

	КонецЦикла;

	Метод.Описание = СвернутьТекст(СтрокиОписания);
	Метод.ВозвращаемоеЗначение = СвернутьТекст(СтрокиВозврата);
	Метод.Пример = СвернутьКод(СтрокиПримера);
	Метод.ДокументацияПараметров = РазобратьПараметрыДокументации(СтрокиПараметров);

КонецПроцедуры

Функция СекцияКомментария(Строка)

	Низ = НРег(СокрЛП(Строка));
	Если Не СтрЗаканчиваетсяНа(Низ, ":") Тогда
		Возврат "";
	КонецЕсли;

	Заголовок = СокрЛП(Лев(Низ, СтрДлина(Низ) - 1));

	Если Заголовок = "описание" Тогда
		Возврат "Описание";
	ИначеЕсли Заголовок = "параметры" Тогда
		Возврат "Параметры";
	ИначеЕсли Заголовок = "возвращаемое значение" Или Заголовок = "возвращаемоезначение" Тогда
		Возврат "Возвращаемое значение";
	ИначеЕсли Заголовок = "пример" Тогда
		Возврат "Пример";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция СвернутьТекст(Строки)

	Части = Новый Массив;
	Для Каждого ТекСтрока Из Строки Цикл
		Части.Добавить(СокрЛП(ТекСтрока));
	КонецЦикла;

	УбратьПустыеСтрокиПоКраям(Части);

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция СвернутьКод(Строки)

	Части = Новый Массив;
	Для Каждого ТекСтрока Из Строки Цикл
		Части.Добавить(ТекСтрока);
	КонецЦикла;

	УбратьПустыеСтрокиПоКраям(Части);

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Отступ = МинимальныйОтступ(Части);
	Если Отступ > 0 Тогда
		СнятьОтступ(Части, Отступ);
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Процедура УбратьПустыеСтрокиПоКраям(Части)

	Пока Части.Количество() > 0 И ПустаяСтрока(СокрЛП(Части[0])) Цикл
		Части.Удалить(0);
	КонецЦикла;

	Пока Части.Количество() > 0 И ПустаяСтрока(СокрЛП(Части[Части.Количество() - 1])) Цикл
		Части.Удалить(Части.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

Функция МинимальныйОтступ(Части)

	Результат = -1;
	Для Каждого ТекСтрока Из Части Цикл
		Если ПустаяСтрока(СокрЛП(ТекСтрока)) Тогда
			Продолжить;
		КонецЕсли;
		Отступ = СтрДлина(ТекСтрока) - СтрДлина(СокрЛ(ТекСтрока));
		Если Результат < 0 Или Отступ < Результат Тогда
			Результат = Отступ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СнятьОтступ(Части, Отступ)

	Для Индекс = 0 По Части.Количество() - 1 Цикл
		Если СтрДлина(Части[Индекс]) >= Отступ Тогда
			Части[Индекс] = Сред(Части[Индекс], Отступ + 1);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция РазобратьПараметрыДокументации(Строки)

	Записи = Новый Массив;
	ТекущаяЗапись = Неопределено;

	Для Каждого ТекСтрока Из Строки Цикл

		Если ПустаяСтрока(СокрЛП(ТекСтрока)) Тогда
			Продолжить;
		КонецЕсли;

		БезОтступа = СокрЛ(ТекСтрока);
		Отступ = СтрДлина(ТекСтрока) - СтрДлина(БезОтступа);
		ЭтоНовыйПараметр = Отступ <= МаксимальныйОтступПараметра()
			И СтрНайти(БезОтступа, РазделительТипаИОписания()) > 0;

		Если ЭтоНовыйПараметр Тогда
			ТекущаяЗапись = НоваяЗаписьПараметра(БезОтступа);
			Записи.Добавить(ТекущаяЗапись);
		ИначеЕсли ТекущаяЗапись <> Неопределено Тогда
			ТекущаяЗапись.Описание.Добавить(СокрЛП(БезОтступа));
		Иначе
			Продолжить;
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Если Не ПустаяСтрока(Запись.Имя) Тогда
			Параметр = Новый Структура;
			Параметр.Вставить("Тип", Запись.Тип);
			Параметр.Вставить("Описание", СтрСоединить(Запись.Описание, " "));
			Результат.Вставить(Запись.Имя, Параметр);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НоваяЗаписьПараметра(БезОтступа)

	Запись = Новый Структура;
	Запись.Вставить("Имя", "");
	Запись.Вставить("Тип", "");
	Запись.Вставить("Описание", Новый Массив);

	Разбор = СтрРазделить(БезОтступа, СокрЛП(РазделительТипаИОписания()));
	Запись.Имя = СокрЛП(Разбор[0]);

	Если Разбор.Количество() >= 2 Тогда
		Запись.Тип = СокрЛП(Разбор[1]);
	КонецЕсли;

	Если Разбор.Количество() >= 3 Тогда
		Части = Новый Массив;
		Для Индекс = 2 По Разбор.Количество() - 1 Цикл
			Части.Добавить(СокрЛП(Разбор[Индекс]));
		КонецЦикла;
		Запись.Описание.Добавить(СтрСоединить(Части, РазделительТипаИОписания()));
	КонецЕсли;

	Возврат Запись;

КонецФункции

Функция ИндексКаталогаТипа(Сегменты, СоответствиеТипов)

	Для Индекс = 0 По Сегменты.Количество() - 1 Цикл
		Если СоответствиеТипов.Получить(Сегменты[Индекс]) <> Неопределено Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция ОписаниеМодуля(Остаток)

	Если Остаток.Количество() = 0 Тогда
		Возврат "Модуль";
	КонецЕсли;

	ИмяФайла = НРег(Остаток[Остаток.Количество() - 1]);

	Если Остаток.Количество() >= 3 И НРег(Остаток[0]) = "forms" И ИмяФайла = "module.bsl" Тогда
		Возврат "Модуль формы «" + Остаток[1] + "»";
	КонецЕсли;

	Если Остаток.Количество() >= 3 И НРег(Остаток[0]) = "commands" Тогда
		Возврат "Модуль команды «" + Остаток[1] + "»";
	КонецЕсли;

	Имена = Новый Соответствие;
	Имена.Вставить("module.bsl", "Модуль");
	Имена.Вставить("objectmodule.bsl", "Модуль объекта");
	Имена.Вставить("managermodule.bsl", "Модуль менеджера");
	Имена.Вставить("recordsetmodule.bsl", "Модуль набора записей");
	Имена.Вставить("valuemanagermodule.bsl", "Модуль менеджера значения");
	Имена.Вставить("commandmodule.bsl", "Модуль команды");
	Имена.Вставить("managedapplicationmodule.bsl", "Модуль управляемого приложения");
	Имена.Вставить("ordinaryapplicationmodule.bsl", "Модуль обычного приложения");
	Имена.Вставить("ksnmodule.bsl", "Модуль обычного приложения");
	Имена.Вставить("externalconnectionmodule.bsl", "Модуль внешнего соединения");
	Имена.Вставить("sessionmodule.bsl", "Модуль сеанса");

	Результат = Имена.Получить(ИмяФайла);
	Если Результат = Неопределено Тогда
		Результат = СтрСоединить(Остаток, "/");
	КонецЕсли;

	Возврат Результат;

КонецФункции

