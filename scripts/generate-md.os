	Соответствие.Вставить("DefinedTypes", "Определяемые типы");
	Соответствие.Вставить("SessionParameters", "Параметры сеанса");
	Соответствие.Вставить("FunctionalOptions", "Функциональные опции");
	Соответствие.Вставить("FunctionalOptionsParameters", "Параметры функциональных опций");
	Соответствие.Вставить("EventSubscriptions", "Подписки на события");
	Соответствие.Вставить("ScheduledJobs", "Регламентные задания");
	Соответствие.Вставить("Languages", "Языки");
