	Возврат Соответствие;

КонецФункции

Функция НаименованиеТипа(СоответствиеТипов, ТипКаталог)

	Наименование = СоответствиеТипов.Получить(ТипКаталог);

	Возврат ?(Наименование = Неопределено, ТипКаталог, Наименование);

КонецФункции

Функция НормализоватьПуть(Путь)

	Результат = СокрЛП(Путь);
	Результат = СтрЗаменить(Результат, "\", "/");

	Пока СтрЗаканчиваетсяНа(Результат, "/") И СтрДлина(Результат) > 3 Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОтносительныйПуть(ПолноеИмя, Каталог)

	Результат = СтрЗаменить(ПолноеИмя, "\", "/");

	Если СтрНачинаетсяС(НРег(Результат), НРег(Каталог) + "/") Тогда
		Возврат Сред(Результат, СтрДлина(Каталог) + 2);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПрочитатьТекстФайла(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Процедура ЗаписатьТекстФайла(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Ложь);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

Функция ПрочитатьСиноним(КаталогРасширения, Сегменты, ИндексОбъекта, ИмяОбъекта)

	ЧастиПути = Новый Массив;
	Для Индекс = 0 По ИндексОбъекта Цикл
		ЧастиПути.Добавить(Сегменты[Индекс]);
	КонецЦикла;

	//БазаПути = КаталогРасширения + "/" + СтрСоединить(ЧастиПути, "/");
	БазаПути = СтрСоединить(ЧастиПути, "/");

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(БазаПути + ".xml");
	Кандидаты.Добавить(БазаПути + "/" + ИмяОбъекта + ".xml");

	Для Каждого ПутьXML Из Кандидаты Цикл
		ФайлXML = Новый Файл(ПутьXML);
		Если ФайлXML.Существует() И ФайлXML.ЭтоФайл() Тогда
			Возврат ИзвлечьСиноним(ПрочитатьТекстФайла(ПутьXML));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИзвлечьСиноним(ТекстXML)

	НачалоЭлемента = СтрНайти(ТекстXML, "<Synonym>");
	Если НачалоЭлемента = 0 Тогда
		Возврат "";
	КонецЕсли;
	НачалоЭлемента = НачалоЭлемента + СтрДлина("<Synonym>");

	КонецЭлемента = СтрНайти(ТекстXML, "</Synonym>", НаправлениеПоиска.СНачала, НачалоЭлемента);
	Если КонецЭлемента = 0 Тогда
		Возврат "";
	КонецЕсли;

	Содержимое = Сред(ТекстXML, НачалоЭлемента, КонецЭлемента - НачалоЭлемента);

	ПозицияКонтента = СтрНайти(Содержимое, "<v8:content>");
	Если ПозицияКонтента > 0 Тогда
		НачалоКонтента = ПозицияКонтента + СтрДлина("<v8:content>");
		КонецКонтента = СтрНайти(Содержимое, "</v8:content>", НаправлениеПоиска.СНачала, НачалоКонтента);
		Если КонецКонтента > 0 Тогда
			ДлинаКонтента = КонецКонтента - НачалоКонтента;
			Возврат РаскодироватьXML(СокрЛП(Сред(Содержимое, НачалоКонтента, ДлинаКонтента)));
		КонецЕсли;
	КонецЕсли;

	Возврат РаскодироватьXML(СокрЛП(УдалитьТеги(Содержимое)));

КонецФункции

Функция УдалитьТеги(Строка)

	Результат = Строка;

	Пока СтрНайти(Результат, "<") > 0 Цикл
		Начало = СтрНайти(Результат, "<");
		Конец = СтрНайти(Результат, ">", НаправлениеПоиска.СНачала, Начало);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Сред(Результат, Конец + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РаскодироватьXML(Строка)

	Результат = Строка;
	Результат = СтрЗаменить(Результат, "&lt;", "<");
	Результат = СтрЗаменить(Результат, "&gt;", ">");
	Результат = СтрЗаменить(Результат, "&quot;", """");
	Результат = СтрЗаменить(Результат, "&apos;", "'");
	Результат = СтрЗаменить(Результат, "&amp;", "&");

	Возврат Результат;

КонецФункции

Функция ЗаписатьДокументацию(КаталогВывода, Объекты, СоответствиеТипов, Журнал)

	Если Объекты.Количество() = 0 Тогда
		Журнал.Добавить("Не найдено ни одного объекта с экспортными методами.");
		Возврат 0;
	КонецЕсли;

	СоздатьКаталог(КаталогВывода);

	ПоТипам = Новый Соответствие;
	Для Каждого КлючИЗначение Из Объекты Цикл
		ОписаниеОбъекта = КлючИЗначение.Значение;
		Список = ПоТипам.Получить(ОписаниеОбъекта.ТипКаталог);
		Если Список = Неопределено Тогда
			Список = Новый Соответствие;
			ПоТипам.Вставить(ОписаниеОбъекта.ТипКаталог, Список);
		КонецЕсли;
		Список.Вставить(ОписаниеОбъекта.Имя, ОписаниеОбъекта);
	КонецЦикла;

	КаталогиТипов = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из ПоТипам Цикл
		КаталогиТипов.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	КаталогиТипов.СортироватьПоЗначению();
	КаталогиТипов = КаталогиТипов.ВыгрузитьЗначения();

	СтрокиИндекса = Новый Массив;
	КоличествоМетодов = 0;
	НомерТипа = 1;

	Для Каждого ТипКаталог Из КаталогиТипов Цикл

		НомерТипа = НомерТипа + 1;
		Наименование = НаименованиеТипа(СоответствиеТипов, ТипКаталог);
		КаталогТипа = КаталогВывода + "/" + ТипКаталог;
		СоздатьКаталог(КаталогТипа);

		ЗаписатьКатегорию(КаталогТипа, Наименование, НомерТипа);

		СписокОбъектов = ПоТипам.Получить(ТипКаталог);
		Имена = ОтсортированныеИмена(СписокОбъектов);

		СтрокиИндекса.Добавить("## " + Наименование);
		СтрокиИндекса.Добавить("");
		СтрокиИндекса.Добавить("| Объект | Методов | Синоним |");
		СтрокиИндекса.Добавить("| --- | ---: | --- |");

		НомерОбъекта = 0;
		Для Каждого Имя Из Имена Цикл

			НомерОбъекта = НомерОбъекта + 1;
			ОписаниеОбъекта = СписокОбъектов.Получить(Имя);
			МетодовОбъекта = КоличествоМетодовОбъекта(ОписаниеОбъекта);
			КоличествоМетодов = КоличествоМетодов + МетодовОбъекта;

			ТекстДокумента = СформироватьДокументОбъекта(ОписаниеОбъекта, Наименование, НомерОбъекта);
			ЗаписатьТекстФайла(КаталогТипа + "/" + Имя + ".md", ТекстДокумента);

			СтрокиИндекса.Добавить(СтрокаИндекса(ТипКаталог, Имя, МетодовОбъекта, ОписаниеОбъекта.Синоним));

			Журнал.Добавить("Записан файл: " + ТипКаталог + "/" + Имя + ".md");

		КонецЦикла;

		СтрокиИндекса.Добавить("");

	КонецЦикла;

	ЗаписатьТекстФайла(КаталогВывода + "/index.md", СформироватьИндекс(СтрокиИндекса));

	Возврат КоличествоМетодов;

КонецФункции

Процедура ЗаписатьКатегорию(КаталогТипа, Наименование, НомерТипа)

	Содержимое = "{""label"": """ + Наименование + """, ""position"": "
		+ Формат(НомерТипа, "ЧГ=0") + "}";

	ЗаписатьТекстФайла(КаталогТипа + "/_category_.json", Содержимое);

КонецПроцедуры

Функция ОтсортированныеИмена(СписокОбъектов)

	Имена = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из СписокОбъектов Цикл
		Имена.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Имена.СортироватьПоЗначению();

	Возврат Имена.ВыгрузитьЗначения();

КонецФункции

Функция СтрокаИндекса(ТипКаталог, Имя, МетодовОбъекта, Синоним)

	Ссылка = "[" + Имя + "](./" + ТипКаталог + "/" + Имя + ".md)";
	Количество = Формат(МетодовОбъекта, "ЧГ=0");

	Возврат "| " + Ссылка + " | " + Количество + " | " + ЭкранироватьЯчейку(Синоним) + " |";

КонецФункции

Функция КоличествоМетодовОбъекта(ОписаниеОбъекта)

	Количество = 0;
	Для Каждого Модуль Из ОписаниеОбъекта.Модули Цикл
		Количество = Количество + Модуль.Методы.Количество();
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция СформироватьИндекс(СтрокиИндекса)

	Строки = Новый Массив;

	Шапка = "---" + Символы.ПС
		+ "title: Документация расширения" + Символы.ПС
		+ "sidebar_position: 1" + Символы.ПС
		+ "---";

	Строки.Добавить(Шапка);
	Строки.Добавить("");
	Строки.Добавить("# Документация расширения");
	Строки.Добавить("");

	Для Каждого Строка Из СтрокиИндекса Цикл
		Строки.Добавить(Строка);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СформироватьДокументОбъекта(ОписаниеОбъекта, НаименованиеТипа, Позиция)

	Строки = Новый Массив;

	Шапка = "---" + Символы.ПС
		+ "title: """ + ОписаниеОбъекта.Имя + """" + Символы.ПС
		+ "sidebar_position: " + Формат(Позиция, "ЧГ=0") + Символы.ПС
		+ "---";

	Строки.Добавить(Шапка);
	Строки.Добавить("");
	Строки.Добавить("# " + ОписаниеОбъекта.Имя);
	Строки.Добавить("");
	Строки.Добавить("**Тип:** " + НаименованиеТипа);

	Если Не ПустаяСтрока(ОписаниеОбъекта.Синоним) И ОписаниеОбъекта.Синоним <> ОписаниеОбъекта.Имя Тогда
		Строки.Добавить("");
		Строки.Добавить("**Синоним:** " + ЭкранироватьТекст(ОписаниеОбъекта.Синоним));
	КонецЕсли;

	Для Каждого Модуль Из ОписаниеОбъекта.Модули Цикл
		Строки.Добавить("");
		Строки.Добавить("## " + Модуль.Вид);
		Для Каждого Метод Из Модуль.Методы Цикл
			ДобавитьОписаниеМетода(Строки, Метод);
		КонецЦикла;
	КонецЦикла;

	Строки.Добавить("");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьОписаниеМетода(Строки, Метод)

	Строки.Добавить("");
	Строки.Добавить("### " + Метод.Заголовок);
	Строки.Добавить("");
	Строки.Добавить("```bsl");
	Строки.Добавить(Метод.Сигнатура);
	Строки.Добавить("```");
	Строки.Добавить("");

	Если ПустаяСтрока(Метод.Описание) Тогда
		Строки.Добавить("_Описание отсутствует._");
	Иначе
		Строки.Добавить(ЭкранироватьТекст(Метод.Описание));
	КонецЕсли;

	ДобавитьТаблицуПараметров(Строки, Метод);
	ДобавитьВозвращаемоеЗначение(Строки, Метод);
	ДобавитьПример(Строки, Метод);

КонецПроцедуры

Процедура ДобавитьТаблицуПараметров(Строки, Метод)

	Если Метод.Параметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("**Параметры:**");
	Строки.Добавить("");
	Строки.Добавить("| Имя | Тип | Описание |");
	Строки.Добавить("| --- | --- | --- |");

	Для Каждого Параметр Из Метод.Параметры Цикл

		ИмяПараметра = ИмяПараметраБезЗнач(Параметр);
		Документация = Метод.ДокументацияПараметров.Получить(ИмяПараметра);
		ТипПараметра = "";
		ОписаниеПараметра = "";

		Если Документация <> Неопределено Тогда
			ТипПараметра = Документация.Тип;
			ОписаниеПараметра = Документация.Описание;
		КонецЕсли;

		Строки.Добавить(СтрокаТаблицыПараметра(ИмяПараметра, ТипПараметра, ОписаниеПараметра));

	КонецЦикла;

КонецПроцедуры

Функция СтрокаТаблицыПараметра(ИмяПараметра, ТипПараметра, ОписаниеПараметра)

	Возврат "| " + ЭкранироватьЯчейку(ИмяПараметра)
		+ " | " + ЭкранироватьЯчейку(ТипПараметра)
		+ " | " + ЭкранироватьЯчейку(ОписаниеПараметра) + " |";

КонецФункции

Процедура ДобавитьВозвращаемоеЗначение(Строки, Метод)

	Если Не Метод.ЭтоФункция Или ПустаяСтрока(Метод.ВозвращаемоеЗначение) Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("**Возвращаемое значение:**");
	Строки.Добавить("");
	Строки.Добавить(ЭкранироватьТекст(Метод.ВозвращаемоеЗначение));

КонецПроцедуры

Процедура ДобавитьПример(Строки, Метод)

	Если ПустаяСтрока(Метод.Пример) Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("**Пример:**");
	Строки.Добавить("");
	Строки.Добавить("```bsl");
	Строки.Добавить(Метод.Пример);
	Строки.Добавить("```");

КонецПроцедуры

Функция ИмяПараметраБезЗнач(Параметр)

	Имя = СокрЛП(Параметр);
	Если СтрНачинаетсяС(НРег(Имя), "знач ") Тогда
		Имя = СокрЛП(Сред(Имя, СтрДлина("знач ") + 1));
	КонецЕсли;
	Если СтрНайти(Имя, "=") > 0 Тогда
		Части = СтрРазделить(Имя, "=");
		Имя = СокрЛП(Части[0]);
	КонецЕсли;

	Возврат Имя;

КонецФункции

Функция ЭкранироватьТекст(Текст)

	Результат = СтрЗаменить(Текст, "{", "\{");
	Результат = СтрЗаменить(Результат, "}", "\}");
	Результат = СтрЗаменить(Результат, "<", "&lt;");

	Возврат Результат;

КонецФункции

Функция ЭкранироватьЯчейку(Текст)

	Результат = ЭкранироватьТекст(Текст);
	Результат = СтрЗаменить(Результат, "|", "\|");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");

	Возврат Результат;

КонецФункции

Функция РазделительТипаИОписания()
	Возврат " - ";
КонецФункции

Функция МаксимальныйОтступПараметра()
	Возврат 4;
КонецФункции

Функция МинимальноеЧислоСегментовПути()
	Возврат 3;
КонецФункции

Функция МаксимумСтрокОбъявления()
	Возврат 100;
КонецФункции

Если АргументыКоманднойСтроки.Количество() < 2 Тогда
	ВывестиСправку();
	ЗавершитьРаботу(1);
КонецЕсли;

КаталогРасширения = АргументыКоманднойСтроки[0];
КаталогВывода = АргументыКоманднойСтроки[1];

Лог = "";
Попытка
	Результат = СгенерироватьДокументацию(КаталогРасширения, КаталогВывода);
	Лог = Результат.Лог;

	Если Результат.КодВозврата Тогда
		Текст = "Готово. Объектов: " + Результат.КоличествоОбъектов
			+ ", методов: " + Результат.КоличествоМетодов + ".";
		Сообщить(Текст);
	Иначе
		Сообщить("Документация не сформирована. " + Лог);
	КонецЕсли;
Исключение
	Лог = "Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	Сообщить("Ошибка при формировании документации. " + Лог);
КонецПопытки;

